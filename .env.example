# ── Server ────────────────────────────────────────────────────
API_KEY=change-me-before-production
PORT=9900

# ── Database ──────────────────────────────────────────────────
# SQLite (dev):
DATABASE_URL=sqlite:guardrail.db
# Postgres (prod):
# DATABASE_URL=postgres://guardrail:guardrail@localhost:5432/guardrail

# ── LLM (mirror augmentation + regex generation) ─────────────
# LLM is opt-in per request. For training: pass enable_mirror=true in the
# train request body. For patterns: pass use_llm=true in the pattern request.
# These credentials are only used when the client explicitly enables LLM features.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=sk-...

# ── Engine limits ─────────────────────────────────────────────
# Maximum input text length in characters.
MAX_TEXT_CHARS=500000

# Mirror augmentation safety cap — per label class per training request.
# The LLM generates at most MIRROR_MAX_RECORDS attack mirrors AND
# at most MIRROR_MAX_RECORDS benign mirrors per training call.
# Total max LLM calls per request = 2 × MIRROR_MAX_RECORDS.
# Set to 0 for unlimited (not recommended on large datasets — can be costly).
MIRROR_MAX_RECORDS=500

# ── Paths ─────────────────────────────────────────────────────
MODELS_DIR=./models
PARAPET_CONFIG=./parapet.yaml
# Python executable path (e.g., python, python3, or full path to conda env python.exe)
PYTHON_EXECUTABLE=python
SCHEMA_EVAL_DIR=./schema/eval
